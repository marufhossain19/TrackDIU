# ── Supabase Configuration ──────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ── Google & Weather APIs ──────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_sdk_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# ── AI Chatbot API ──────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/auto

# ── bKash Sandbox (Demo Credentials) ─────────────────────────
BKASH_BASE_SANDBOX_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_LIVE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
